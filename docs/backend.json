
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public and private profile data for users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "favoriteClasses": { "type": "array", "items": { "type": "string" } },
        "favoriteRaces": { "type": "array", "items": { "type": "string" } },
        "defaultTheme": { "type": "string" },
        "dicePreference": { "type": "string", "enum": ["virtual", "physical", "ask"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "A game campaign managed by a Game Master.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "masterId": { "type": "string" },
        "system": { "type": "string" },
        "tone": { "type": "string" },
        "bannerImage": { "type": "string" },
        "isAiNarratorEnabled": { "type": "boolean" },
        "isSoloJourneyEnabled": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "archived", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "masterId", "status"]
    },
    "Session": {
      "title": "Session",
      "description": "A specific game session within a campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "diceMode": { "type": "string", "enum": ["virtual", "physical", "flexible"], "default": "flexible" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campaignId", "title", "status"]
    },
    "Chronicle": {
      "title": "Chronicle",
      "description": "A canonical historical record of a completed session.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "sessionId": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "importantDecisions": { "type": "array", "items": { "type": "string" } },
        "npcsEncountered": { "type": "array", "items": { "type": "string" } },
        "itemsGained": { "type": "array", "items": { "type": "string" } },
        "masterSecrets": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campaignId", "sessionId", "title", "summary"]
    },
    "ApprovalRequest": {
      "title": "Approval Request",
      "description": "A pending request for the GM to approve or reject.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["character", "item", "travel", "combat", "dialogue"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "requesterId": { "type": "string" },
        "metadata": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "status", "requesterId"]
    },
    "Character": {
      "title": "Character",
      "description": "A player character linked to a campaign with D&D 5e stats.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "race": { "type": "string" },
        "class": { "type": "string" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "hp": { "type": "number" },
        "maxHp": { "type": "number" },
        "mana": { "type": "number", "description": "Current mana or spell energy." },
        "maxMana": { "type": "number", "description": "Maximum mana or spell energy." },
        "ac": { "type": "number" },
        "initiative": { "type": "number" },
        "photoURL": { "type": "string" },
        "conditions": { "type": "array", "items": { "type": "string" }, "description": "Active status effects like Poisoned, Blinded, etc." },
        "stats": {
          "type": "object",
          "properties": {
            "str": { "type": "number" },
            "dex": { "type": "number" },
            "con": { "type": "number" },
            "int": { "type": "number" },
            "wis": { "type": "number" },
            "cha": { "type": "number" }
          }
        },
        "status": { "type": "string", "enum": ["pending", "active", "dead"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campaignId", "ownerId", "name", "status"]
    },
    "NPC": {
      "title": "NPC",
      "description": "A non-player character managed by the GM or IA.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "personality": { "type": "string" },
        "goals": { "type": "string" },
        "knows": { "type": "array", "items": { "type": "string" } },
        "secrets": { "type": "array", "items": { "type": "string" } },
        "imageURL": { "type": "string" },
        "status": { "type": "string", "enum": ["alive", "dead", "missing"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campaignId", "name", "status"]
    },
    "Location": {
      "title": "Location",
      "description": "A point of interest on the Live Map.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["city", "dungeon", "forest", "mystery", "danger"] },
        "status": { "type": "string", "enum": ["unknown", "known", "active", "locked"] },
        "coords": {
          "type": "object",
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "pointsOfInterest": { "type": "array", "items": { "type": "string" } },
        "isSecret": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campaignId", "name", "status"]
    },
    "Item": {
      "title": "Item",
      "description": "A narrative object in the chronicle.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "appearance": { "type": "string" },
        "howObtained": { "type": "string" },
        "knownProperties": { "type": "array", "items": { "type": "string" } },
        "masterSecret": { "type": "string" },
        "type": { "type": "string", "enum": ["weapon", "armor", "magic", "document", "tool", "misc"] },
        "ownerId": { "type": "string", "description": "ID of Character or NPC who currently holds the item." },
        "campaignId": { "type": "string" },
        "status": { "type": "string", "enum": ["carried", "stored", "lost", "pending"] }
      },
      "required": ["id", "name", "campaignId", "status"]
    },
    "DiaryEntry": {
      "title": "Diary Entry",
      "description": "A personal note in a character's journal.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "characterId": { "type": "string" },
        "campaignId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["thought", "clue", "speech", "fact"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "characterId", "content"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Campaign data."
    },
    "/campaigns/{campaignId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Sessions for a campaign."
    },
    "/campaigns/{campaignId}/chronicles/{chronicleId}": {
      "schema": "Chronicle",
      "description": "Canonical records for the campaign history."
    },
    "/campaigns/{campaignId}/approval_requests/{requestId}": {
      "schema": "ApprovalRequest",
      "description": "Pending approvals for the GM."
    },
    "/campaigns/{campaignId}/characters/{characterId}": {
      "schema": "Character",
      "description": "Characters in a campaign."
    },
    "/campaigns/{campaignId}/npcs/{npcId}": {
      "schema": "NPC",
      "description": "NPCs in a campaign."
    },
    "/campaigns/{campaignId}/locations/{locationId}": {
      "schema": "Location",
      "description": "Locations on the map."
    },
    "/campaigns/{campaignId}/items/{itemId}": {
      "schema": "Item",
      "description": "Campaign items."
    },
    "/campaigns/{campaignId}/characters/{characterId}/diary/{entryId}": {
      "schema": "DiaryEntry",
      "description": "Journal entries for characters."
    }
  }
}
