
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Public and private profile data for users.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "favoriteClasses": { "type": "array", "items": { "type": "string" } },
        "favoriteRaces": { "type": "array", "items": { "type": "string" } },
        "defaultTheme": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Campaign": {
      "title": "Campaign",
      "description": "A game campaign managed by a Game Master.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "masterId": { "type": "string" },
        "system": { "type": "string" },
        "tone": { "type": "string" },
        "bannerImage": { "type": "string" },
        "isAiNarratorEnabled": { "type": "boolean" },
        "isSoloJourneyEnabled": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "archived", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "masterId", "status"]
    },
    "Character": {
      "title": "Character",
      "description": "A player character linked to a campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "race": { "type": "string" },
        "class": { "type": "string" },
        "level": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "active", "dead"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campaignId", "ownerId", "name", "status"]
    },
    "NPC": {
      "title": "NPC",
      "description": "A non-player character managed by the GM or IA.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "personality": { "type": "string" },
        "goals": { "type": "string" },
        "knows": { "type": "array", "items": { "type": "string" } },
        "secrets": { "type": "array", "items": { "type": "string" } },
        "imageURL": { "type": "string" },
        "status": { "type": "string", "enum": ["alive", "dead", "missing"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campaignId", "name", "status"]
    },
    "Session": {
      "title": "Session",
      "description": "A game session within a campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignId": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campaignId", "title", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "A message sent in the live table chat.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sessionId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["speech", "action", "narration", "dice", "off"] },
        "npcId": { "type": "string" },
        "rollData": {
          "type": "object",
          "properties": {
            "formula": { "type": "string" },
            "result": { "type": "number" },
            "isPhysical": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sessionId", "senderId", "text", "type"]
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Campaign data."
    },
    "/campaigns/{campaignId}/characters/{characterId}": {
      "schema": "Character",
      "description": "Characters in a campaign."
    },
    "/campaigns/{campaignId}/npcs/{npcId}": {
      "schema": "NPC",
      "description": "NPCs in a campaign."
    },
    "/campaigns/{campaignId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Sessions in a campaign."
    },
    "/campaigns/{campaignId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages in a session."
    }
  }
}
