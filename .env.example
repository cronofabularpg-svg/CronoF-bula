# ============================================================
# CRONOFÁBULA — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local ou qualquer arquivo com chaves reais.
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ATENÇÃO: SUPABASE_SERVICE_ROLE_KEY nunca pode ir para o frontend
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (https://dash.cloudflare.com)
# ATENÇÃO: estas chaves nunca podem ir para o frontend
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# IA — use apenas uma ou ambas
GROQ_API_KEY=
OPENAI_API_KEY=

# Segurança interna
APP_ENCRYPTION_KEY=
