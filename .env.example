# ============================================================
# CRONOFÁBULA — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local ou qualquer arquivo com chaves reais.
#
# Convenção:
# - Prefixo NEXT_PUBLIC_ = exposto ao browser (bundle client). Use
#   apenas para valores que já são públicos por natureza (URL do
#   projeto Supabase, anon key, URL pública do site).
# - Sem prefixo NEXT_PUBLIC_ = visível apenas no servidor (Route
#   Handlers, Server Actions, Server Components). Nunca importar
#   esses valores em arquivos com "use client".
# ============================================================

# ------------------------------------------------------------
# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
# ------------------------------------------------------------
# Pública: URL do projeto Supabase. Usada no client e no servidor.
NEXT_PUBLIC_SUPABASE_URL=
# Pública: anon/public key. Respeita RLS, segura para o browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: service role key. Ignora RLS — apenas server-side
# (src/lib/supabase/admin.ts). NUNCA prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Groq (https://console.groq.com/keys)
# ------------------------------------------------------------
# SECRETA: usada apenas em rotas server-side (src/lib/ai/groq.ts,
# src/app/api/ai/*). NUNCA prefixar com NEXT_PUBLIC_.
GROQ_API_KEY=

# ------------------------------------------------------------
# App / Site
# ------------------------------------------------------------
# Pública: URL pública do site (usada em links absolutos, metadata,
# callbacks de auth etc.). Em produção, igual ao domínio na Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:9002

# ------------------------------------------------------------
# Cloudflare R2 (https://dash.cloudflare.com -> R2 -> Manage API Tokens)
# Opcional por enquanto — recursos de mídia/upload ainda não usam R2.
# Quando ausentes, o app continua funcionando normalmente.
# ------------------------------------------------------------
# SECRETA: nunca prefixar com NEXT_PUBLIC_.
CLOUDFLARE_R2_ACCOUNT_ID=
# SECRETA: nunca prefixar com NEXT_PUBLIC_.
CLOUDFLARE_R2_ACCESS_KEY_ID=
# SECRETA: nunca prefixar com NEXT_PUBLIC_.
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# SECRETA: nome do bucket (não é segredo em si, mas mantido fora do client).
CLOUDFLARE_R2_BUCKET=
# Pública: domínio público de entrega dos arquivos do bucket (CDN/custom domain).
CLOUDFLARE_R2_PUBLIC_URL=
